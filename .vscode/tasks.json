{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake-build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build",
        "--config",
        "Debug",
        "--parallel"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Build Qallow project with CMake (CPU)"
    },
    {
      "label": "cmake-build-cuda",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build",
        "--config",
        "Debug",
        "--parallel",
        "--target",
        "qallow_unified_cuda"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "Build Qallow CUDA project with CMake"
    },
    {
      "label": "cmake-configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DQALLOW_ENABLE_CUDA=ON"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "Configure Qallow project with CMake"
    },
    {
      "label": "make-build",
      "type": "shell",
      "command": "make",
      "args": [
        "-C",
        "${workspaceFolder}",
        "all"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "Build Qallow project with Makefile"
    },
    {
      "label": "Qallow Phase13",
      "type": "shell",
      "command": "./qallow --threads=auto --watch=${workspaceFolder}",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
